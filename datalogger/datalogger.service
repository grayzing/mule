[Unit]
Description=DAF RPi Datalogger Accumulation Serice
After=network.target time-sync.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/gray/mule/datalogger
ExecStartPre=/bin/sleep 5
ExecStart=/home/gray/mule/datalogger/daf_datalogger_venv/bin/python3 datalogger.py
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target