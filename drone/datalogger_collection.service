[Unit]
Description=DAF RPi Drone Soil Data Collection Service
After=network.target time-sync.target

[Service]
Type=simple
User=julie
WorkingDirectory=~/mule/drone/
ExecStartPre=/bin/sleep 5
ExecStart=~/mule/drone/daf_drone_venv/python3 host_api_endpoint.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target